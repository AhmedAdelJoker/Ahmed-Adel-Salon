{
  "name": "salon-management-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "lint": "eslint src",
    "lint:a11y": "eslint src --rule 'jsx-a11y/anchor-is-valid: error' --rule 'jsx-a11y/click-events-have-key-events: error' --rule 'jsx-a11y/no-noninteractive-element-interactions: error' --rule 'jsx-a11y/role-has-required-aria-props: error' --rule 'jsx-a11y/aria-props: error'",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:a11y": "vitest run src/test/a11y",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "playwright:a11y": "playwright test --config=playwright.a11y.config.ts",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:preview": "npm run build && electron ."
  },
  "build": {
    "appId": "com.salonmanagement.pro",
    "productName": "Salon Management Pro",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asar": false
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "i18next": "^23.4.0",
    "i18next-browser-languagedetector": "^7.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.292.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^13.2.1",
    "react-router-dom": "^6.18.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.10",
    "axe-core": "^4.13.0",
    "canvas": "^3.2.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.12",
    "vite-plugin-checker": "^0.7.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
