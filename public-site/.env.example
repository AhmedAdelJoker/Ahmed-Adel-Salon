# ─────────────────────────────────────────────────────────────────────────────
# public-site environment
#
# Copy to `.env` (or `.env.local`) and fill in. Every variable is optional:
# with none of them set the site builds and runs with same-origin defaults.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. Used for canonical URLs, Open Graph URLs, sitemap.xml,
# robots.txt and hreflang alternates. MUST match the deployed origin exactly,
# or search engines will be told the site lives somewhere it does not.
# Also read by scripts/prerender.mjs at build time.
VITE_SITE_URL=https://salon-pro.com

# Base URL of the booking API, including the /api/v1 suffix.
# Leave unset to use the same-origin relative path "/api/v1", which is what
# both `vite dev` (via its proxy) and `vite preview` serve. Only set this when
# the API is on a different origin — and if you do, add that origin to
# `connect-src` in netlify.toml, vercel.json and public/_headers.
# VITE_API_URL=https://api.salon-pro.com/api/v1

# ── build-time only, not shipped ──────────────────────────────────────────────
# Where scripts/prerender.mjs fetches /public/booking-catalog from while
# prerendering. Set this to emit real static documents for
# /salon/:slug/service/:id, /barber/:id and /offer/:id, so a crawler and a
# no-JavaScript visitor get the title, canonical, price and JSON-LD in the HTML.
#
# The endpoint returns 404 until the site is published, which is the normal
# state for a fresh install — that is reported and skipped, not an error.
#
# Unset, the build still succeeds and those routes are served client-side only.
# Do NOT point this at a production API from a pull-request build.
# PRERENDER_API_URL=http://127.0.0.1:8000

# Dialling prefix for wa.me links, digits only, no "+" (e.g. 20, 971, 966).
# Numbers that already start with "+" are passed through untouched.
# Without this, WhatsApp links omit the country code and go nowhere.
# VITE_WHATSAPP_COUNTRY=20

# Exchange rates as JSON, keyed by currency code. Only used when the site
# actually displays converted prices. Omit it and amounts are shown unchanged
# in the visitor's chosen currency rather than converted at an invented rate.
# VITE_CURRENCY_RATES={"USD":0.0209,"EUR":0.0192}

# ── optional third-party integrations ──────────────────────────────────────
# Each is a no-op when unset. When one IS set, its origin must be permitted by
# the Content-Security-Policy in netlify.toml / vercel.json / public/_headers.

# Plausible Analytics — cookie-free, no personal data.
# The only third-party integration currently permitted. Uncomment and set to
# receive pageviews plus the booking conversion events wired in Analytics.tsx.
# VITE_PLAUSIBLE_DOMAIN=salon-pro.com

# Session-recording chat widgets are deliberately NOT supported.
# Crisp was removed for recording the booking form's name/phone/email/notes,
# and its origin is no longer in the CSP. The salon is reachable on WhatsApp
# instead, which involves no vendor holding the visitor's session.
# Reintroducing one requires an in-site consent banner and a written decision
# about what the vendor may capture.
