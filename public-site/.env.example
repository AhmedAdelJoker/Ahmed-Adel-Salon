# Public Site Environment Variables
# Copy to .env.local and fill in your values

# Backend API
VITE_API_URL=http://localhost:8000/api/v1

# Analytics — Plausible (privacy-friendly, GDPR-compliant)
# Get your domain at https://plausible.io
VITE_PLAUSIBLE_DOMAIN=

# Analytics — Microsoft Clarity (heatmaps + session recordings)
# Get your Project ID at https://clarity.microsoft.com
VITE_CLARITY_PROJECT_ID=

# Live Chat — Crisp (recommended)
# Get your Website ID at https://crisp.chat
VITE_CRISP_WEBSITE_ID=

# Realtime Booking — SSE/polling subscription
# In production this is always on. In dev mode it's disabled by default
# to avoid 404 spam when the backend route isn't running.
# Set to "true" ONLY if you're testing the /api/v1/public/realtime/booking endpoint locally.
VITE_ENABLE_REALTIME=false
