# Cloudflare Pages / Netlify edge cache headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Hashed assets — cache aggressively (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Service worker — never cache (must always be fresh)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Static root assets — cache 1 day
/favicon.ico
  Cache-Control: public, max-age=86400
/icon-*.png
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=3600

# Pre-rendered HTML pages — short edge cache + SWR
/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/book
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
/salon/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=3600
/offline
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

# Security headers — apply to everything
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://client.crisp.chat https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' https:; connect-src 'self' https: wss:; frame-src https://client.crisp.chat
